# J Star Reviewer Environment Variables
# Copy this to .env.local for local testing

# GitHub Personal Access Token (needs repo & pull_request permissions)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (for gpt-4o-mini and gpt-4o)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Repository (format: owner/repo)
GITHUB_REPOSITORY=your-username/your-repo

# PR Number to review (for local testing)
PR_NUMBER=1

# Model Name (optional, defaults to moonshotai/kimi-k2-instruct-0905)
REVIEW_MODEL_NAME=moonshotai/kimi-k2-instruct-0905


# Required: Gemini API key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Groq API key for LLM reviews
GROQ_API_KEY=your_groq_api_key_here
